# API
FLASK_ENV=development
API_HOST=0.0.0.0
API_PORT=5000

# Storage and queue
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=../data

# PaddleOCR-VL
PADDLE_OCR_MODE=python_api
PADDLE_OCR_BASE_URL=http://127.0.0.1:8118
PADDLE_OCR_SERVER_URL=http://127.0.0.1:8118/v1
PADDLE_OCR_API_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
PADDLE_OCR_API_KEY=EMPTY
PADDLE_OCR_MAX_CONCURRENCY=4
PADDLE_OCR_TIMEOUT_SECONDS=180
PADDLE_OCR_FILE_MODE=base64
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# 实体识别、实体归并、关系抽取与校对共用的模型连接
# 地址支持 /v1 或完整的 /v1/chat/completions 后缀
LLM_BACKEND=vllm
LLM_BASE_URL=your_base_url_here
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen3.8-27b
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_ENABLE_THINKING=false
# 包含首次请求的最大尝试次数；等待时间随尝试次数递增
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# Pipeline concurrency and output limits
OCR_CONCURRENCY=1
LLM_CONCURRENCY=4
MAX_CHUNK_CHARS=2400
SENTENCE_STAGE_LIMIT=12
PAGE_STAGE_LIMIT=12
WORKER_POLL_SECONDS=2

# Relation extraction batching
RELATION_SPLIT_MODE=small_section
RELATION_BATCH_SIZE=1
RELATION_CHAPTER_BATCH_SIZE=2
RELATION_PARAGRAPH_BATCH_SIZE=5
RELATION_FIXED_SECTION_BATCH_SIZE=1
RELATION_MAX_BATCH_TOKENS=2500
RELATION_INCLUDE_PARENT_TITLE=true
RELATION_BATCH_CONCURRENCY=4
EXTRACTION_MAX_REQUEST_TOKENS=65536

# 抽取配置由网页维护，保存在 STORAGE_ROOT/settings/extraction-schema.json
# 每篇文档开始处理时绑定配置版本，实体与关系阶段共用该版本

# 实体与关系阶段的流式输出
# STREAM_ENABLED=false 使用非流式调用
# STREAM_THINKING 控制兼容服务的思考输出
STREAM_ENABLED=true
STREAM_THINKING=true
