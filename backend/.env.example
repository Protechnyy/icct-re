# API
FLASK_ENV=development
API_HOST=0.0.0.0
API_PORT=5000

# Storage and queue
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=../data

# PaddleOCR-VL
PADDLE_OCR_MODE=python_api
PADDLE_OCR_BASE_URL=http://127.0.0.1:8118
PADDLE_OCR_SERVER_URL=http://127.0.0.1:8118/v1
PADDLE_OCR_API_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
PADDLE_OCR_API_KEY=EMPTY
PADDLE_OCR_MAX_CONCURRENCY=4
PADDLE_OCR_TIMEOUT_SECONDS=180
PADDLE_OCR_FILE_MODE=base64
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# 关系抽取、skills 路由、校验智能体共用的模型连接
# 地址支持 /v1 或完整的 /v1/chat/completions 后缀
LLM_BACKEND=vllm
LLM_BASE_URL=your_base_url_here
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen3.8-27b
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_ENABLE_THINKING=false
# 包含首次请求的最大尝试次数；等待时间随尝试次数递增
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# Pipeline concurrency and output limits
OCR_CONCURRENCY=1
LLM_CONCURRENCY=4
MAX_CHUNK_CHARS=2400
SENTENCE_STAGE_LIMIT=12
PAGE_STAGE_LIMIT=12
WORKER_POLL_SECONDS=2

# Relation extraction batching
RELATION_SPLIT_MODE=small_section
RELATION_BATCH_SIZE=1
RELATION_CHAPTER_BATCH_SIZE=2
RELATION_PARAGRAPH_BATCH_SIZE=5
RELATION_FIXED_SECTION_BATCH_SIZE=1
RELATION_MAX_BATCH_TOKENS=2500
RELATION_INCLUDE_PARENT_TITLE=true
RELATION_BATCH_CONCURRENCY=4

# Skill4RE
SKILL4RE_SKILLS_DIR=../skill4re/skill4re/skills
SKILL4RE_ROUTE_CACHE_PATH=../data/tmp/skill4re_route_cache.json
SKILL4RE_CHUNK_TRIGGER=1200
SKILL4RE_CHUNK_BUDGET=900
SKILL4RE_MAX_WORKERS=4
SKILL4RE_FAST_MODE=false
SKILL4RE_SKIP_COREF=false

# LLM stream relay for the extraction stage
# STREAM_ENABLED=false falls back to non-streaming calls (no delta events)
# STREAM_THINKING controls enable_thinking on streaming calls (reasoning_content deltas)
STREAM_ENABLED=true
STREAM_THINKING=true

# 文档级校验智能体运行限制；模型连接使用公共 LLM 配置
VERIFICATION_AGENT_ENABLED=false
# 校验任务串行执行
VERIFICATION_AGENT_CONCURRENCY=1
VERIFICATION_AGENT_MAX_TASKS=20
VERIFICATION_AGENT_MAX_STEPS=6
VERIFICATION_AGENT_MAX_LLM_CALLS=80
# 整篇文档校验的总时限，单次请求同时遵守 LLM_REQUEST_TIMEOUT_SECONDS
VERIFICATION_AGENT_TIMEOUT_SECONDS=600
VERIFICATION_AGENT_MAX_ADDED_PER_TASK=5
